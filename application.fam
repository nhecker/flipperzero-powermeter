App(
    appid="powermeter",
    name="Power Meter",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="powermeter_app",
    stack_size=4 * 1024,
    fap_category="GPIO",
    fap_icon="powermeter_10px.png",
    fap_version="1.0",
    fap_author="Nick Hecker",
    fap_weburl="https://github.com/nhecker/flipperzero-powermeter",
    fap_description="Counts pulse-output utility meter LEDs via GPIO or the onboard IR receiver and shows instantaneous demand, rolling averages and graphs.",
    sources=[
        "powermeter.c",
        "pm_calc.c",
        "pm_meter.c",
        "pm_settings.c",
        "pm_view.c",
    ],
)
